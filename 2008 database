import sqlite3
from turtle import st 

def conectar ():
    conn = sqlite3.connect("escola.db")
    return conn

def criar_tabela ():
    conn = conectar()
    cursor = conn.cursor ()
    cursor.execute ("""
  

    CREATE TABLE IF NOT EXISTS alunos (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT(150) NOT NULL,
    idade INTEGER NOT NULL,
    nota REAL 
    )
    """)
    conn.commit()
    conn.close()

